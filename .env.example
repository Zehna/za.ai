# za.ai configuration — copy to .env (git-ignored) and adjust.
# NEVER commit real API keys. In Codespaces, prefer Secrets
# (Settings → Codespaces → Secrets) over files.

# Which chat backend to use: "mock" (no key needed) or "openai-compat".
PROVIDER=mock

# Model identifier reported to clients and sent to the provider.
# OPENAI_MODEL wins over MODEL for the openai-compat provider.
# Defaults: za-mock-1 (mock) / gpt-4o-mini (openai-compat)
# MODEL=za-mock-1
# OPENAI_MODEL=gpt-4o-mini

# HTTP server bind address and port.
HOST=0.0.0.0
PORT=3000

# --- openai-compat provider only ---
# Works with OpenAI or any OpenAI-compatible endpoint (vLLM, Ollama, Azure…).
# OPENAI_API_KEY is REQUIRED when PROVIDER=openai-compat.
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- conversation behavior ---
# Optional system prompt prepended to every request.
# SYSTEM_PROMPT=You are za.ai, a helpful assistant.
# Max messages of history sent to the provider per request (2-1000).
# MAX_HISTORY_MESSAGES=20
# Max characters accepted in a single user message (1-1000000).
# MAX_MESSAGE_CHARS=32000
# Max messages retained per conversation; oldest are dropped (2-10000).
# MAX_CONVERSATION_MESSAGES=200
# Timeout for non-streaming provider requests in ms (1000-600000).
# PROVIDER_TIMEOUT_MS=60000
